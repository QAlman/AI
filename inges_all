import os
import pickle
import docx
import faiss
import numpy as np
import ollama
import openpyxl
from pypdf import PdfReader


# --- ФУНКЦИИ ДЛЯ ЧТЕНИЯ РАЗНЫХ ФОРМАТОВ ---

def read_pdf(file_path):
    text = ""
    try:
        reader = PdfReader(file_path)
        for page in reader.pages:
            text += page.extract_text() or ""
    except Exception as e:
        print(f"Ошибка чтения PDF {file_path}: {e}")
    return text


def read_docx(file_path):
    text = ""
    try:
        doc = docx.Document(file_path)
        for para in doc.paragraphs:
            text += para.text + "\n"
    except Exception as e:
        print(f"Ошибка чтения DOCX {file_path}: {e}")
    return text


def read_excel(file_path):
    text = ""
    try:
        wb = openpyxl.load_workbook(file_path, data_only=True)
        for sheet in wb.sheetnames:
            ws = wb[sheet]
            for row in ws.iter_rows(values_only=True):
                # Объединяем ячейки строки в одну строку текста
                row_text = " ".join([str(cell) for cell in row if cell is not None])
                if row_text.strip():
                    text += row_text + "\n"
    except Exception as e:
        print(f"Ошибка чтения Excel {file_path}: {e}")
    return text


# --- ФУНКЦИЯ НАРЕЗКИ ТЕКСТА (Chunking) ---
# Режем текст на части, чтобы модель не запуталась и поиск был точным
def split_text(text, chunk_size=700, overlap=100):
    chunks = []
    start = 0
    while start < len(text):
        end = start + chunk_size
        chunks.append(text[start:end])
        start += chunk_size - overlap
    return chunks


# --- ОСНОВНОЙ ПРОЦЕСС ЗАГРУЗКИ ---

DATA_DIR = "./data"
all_chunks = []
metadata_list = []

print("📂 Шаг 1: Сканируем папку с документами...")
for root, dirs, files in os.walk(DATA_DIR):
    for file in files:
        file_path = os.path.join(root, file)
        ext = file.lower()

        file_text = ""
        if ext.endswith('.pdf'):
            file_text = read_pdf(file_path)
        elif ext.endswith('.docx') or ext.endswith('.doc'):
            # Внимание: для старого формата .doc может потребоваться пересохранить его в .docx,
            # если библиотека python-docx выдаст ошибку структуры.
            file_text = read_docx(file_path)
        elif ext.endswith('.xlsx') or ext.endswith('.xls'):
            file_text = read_excel(file_path)

        if file_text.strip():
            # Нарезаем текст документа на куски
            chunks = split_text(file_text)
            print(f"📄 Обработан файл: {file} (Создано частей: {len(chunks)})")

            for chunk in chunks:
                all_chunks.append(chunk)
                metadata_list.append({
                    "text": chunk,
                    "source": file
                })

if not all_chunks:
    print("❌ В папке data не найдено подходящих текстовых данных. Проверьте файлы!")
    exit()

print(f"\n🔄 Шаг 2: Генерация векторов для {len(all_chunks)} фрагментов через Ollama...")
embeddings_list = []

for i, chunk in enumerate(all_chunks):
    response = ollama.embed(model="nomic-embed-text", input=chunk)
    embeddings_list.append(response["embeddings"][0])
    if (i + 1) % 10 == 0 or (i + 1) == len(all_chunks):
        print(f"  Сгенерировано: {i + 1}/{len(all_chunks)}")

# Переводим в формат, который понимает FAISS
embeddings_array = np.array(embeddings_list, dtype=np.float32)

print("\n💾 Шаг 3: Создание и сохранение базы FAISS...")
dimension = embeddings_array.shape[1]
index = faiss.IndexFlatL2(dimension)
index.add(embeddings_array)

# Сохраняем индекс
faiss.write_index(index, "cis_faiss.index")

# Формируем словарь метаданных для быстрого сопоставления ID -> Текст
documents_metadata = {i: metadata_list[i] for i in range(len(metadata_list))}

with open("cis_metadata.pkl", "wb") as f:
    pickle.dump(documents_metadata, f)

print(f"\n✅ УСПЕХ! База знаний успешно создана. Всего фрагментов в базе: {index.ntotal}")
